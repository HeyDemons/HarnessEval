{
  "schema_version": 1,
  "benchmarks": [
    {
      "id": "automationbench",
      "name": "AutomationBench public workflows",
      "source": {
        "url": "https://github.com/zapier/AutomationBench.git",
        "revision": "4a8e1061254004d9dac807054eed33fad7d1ff14",
        "release": "1.0.6"
      },
      "adapter": {
        "kind": "docker-image",
        "image": "orch-bench/automationbench:4a8e106",
        "dockerfile": "${PLATFORM_ROOT}/images/automationbench.Dockerfile",
        "build_context": "${PLATFORM_ROOT}",
        "build_args": {"SOURCE_REV": "4a8e1061254004d9dac807054eed33fad7d1ff14"},
        "source_checkout": {
          "url": "https://github.com/zapier/AutomationBench.git",
          "revision": "4a8e1061254004d9dac807054eed33fad7d1ff14",
          "path": "${PLATFORM_ROOT}/.sources/automationbench"
        },
        "build_contexts": {"source": "${PLATFORM_ROOT}/.sources/automationbench"},
        "image_labels": {"org.orch.benchmark.source-revision": "4a8e1061254004d9dac807054eed33fad7d1ff14"},
        "pre_pull": ["ghcr.io/astral-sh/uv:python3.13-bookworm-slim"],
        "read_only": false
      },
      "smoke": {
        "case_id": "public-registry-and-native-tools",
        "network": "none",
        "command": ["python", "-c", "from automationbench.domains import PUBLIC_DOMAINS,get_domain_dataset; from automationbench.tools.api import API_TOOLS; from automationbench.rubric import partial_credit,task_completed_correctly; import json; print(json.dumps({'domains':{d:len(get_domain_dataset(d)) for d in PUBLIC_DOMAINS},'tools':[f.__name__ for f in API_TOOLS]}))"]
      },
      "scoring": {
        "authority": "AutomationBench native task_completed_correctly and partial_credit assertions",
        "comparability": "official_public_subset",
        "note": "Strict task_completed_correctly is the reported score; partial credit is retained separately. The public suite is not the private leaderboard."
      },
      "env_allowlist": []
    },
    {
      "id": "gaia",
      "name": "GAIA 2023",
      "source": {
        "data": "gaia-benchmark/GAIA",
        "scorer": "https://huggingface.co/spaces/gaia-benchmark/leaderboard/blob/main/scorer.py",
        "local_snapshot": "${ORCH_ROOT}/gaia_data"
      },
      "adapter": {
        "kind": "docker-image",
        "image": "orch-bench/workspace-core:0.1",
        "dockerfile": "${PLATFORM_ROOT}/images/portable.Dockerfile",
        "build_context": "${PLATFORM_ROOT}",
        "target": "core",
        "fingerprint_paths": ["${PLATFORM_ROOT}/drivers/portable_smoke.py", "${PLATFORM_ROOT}/drivers/toolset_probe.py", "${PLATFORM_ROOT}/drivers/web_search.py", "${PLATFORM_ROOT}/benchmark_platform/scorers/gaia.py"],
        "pre_pull": ["python:3.12-slim"],
        "read_only": true
      },
      "required_paths": [
        {"name": "GAIA dataset", "path": "${ORCH_ROOT}/gaia_data", "type": "directory"}
      ],
      "mounts": [
        {"host": "${ORCH_ROOT}/gaia_data", "container": "/data", "mode": "ro"}
      ],
      "smoke": {
        "case_id": "dataset-and-scorer-oracle",
        "network": "none",
        "command": ["python", "/opt/platform/toolset_probe.py", "gaia"]
      },
      "scoring": {
        "authority": "GAIA leaderboard answer scorer",
        "comparability": "official",
        "note": "The platform implementation follows the public leaderboard normalization and is regression-tested in Docker."
      },
      "env_allowlist": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY", "DEEPSEEK_API_KEY", "DEEPSEEK_BASE_URL"]
    },
    {
      "id": "gdpval",
      "name": "GDPval",
      "source": {
        "grading": "https://evals.openai.com/gdpval/grading",
        "local_snapshot": "${ORCH_ROOT}/gdpval",
        "revision": "11e7900cdcac61bc4daf59e65feb238acda98fbf"
      },
      "adapter": {
        "kind": "docker-image",
        "image": "orch-bench/workspace-office:0.1",
        "dockerfile": "${PLATFORM_ROOT}/images/portable.Dockerfile",
        "build_context": "${PLATFORM_ROOT}",
        "target": "office",
        "fingerprint_paths": ["${PLATFORM_ROOT}/drivers/portable_smoke.py", "${PLATFORM_ROOT}/drivers/toolset_probe.py", "${PLATFORM_ROOT}/drivers/web_search.py", "${PLATFORM_ROOT}/benchmark_platform/scorers/gaia.py"],
        "pre_pull": ["python:3.12-slim"],
        "read_only": true
      },
      "required_paths": [
        {"name": "GDPval dataset", "path": "${ORCH_ROOT}/gdpval", "type": "directory"},
        {"name": "GDPval v2 parquet", "path": "${ORCH_ROOT}/gdpval/data/train-00000-of-00001.parquet", "type": "file", "sha256": "f8422fab9b21d90c0ee5f0659842ab666d418cb8940842918f9f4b0df7ae0202"},
        {"name": "GDPval reference files", "path": "${ORCH_ROOT}/gdpval/reference_files", "type": "directory"},
        {"name": "GDPval gold deliverables", "path": "${ORCH_ROOT}/gdpval/deliverable_files", "type": "directory"}
      ],
      "mounts": [
        {"host": "${ORCH_ROOT}/gdpval", "container": "/data", "mode": "ro"}
      ],
      "smoke": {
        "case_id": "dataset-rubric-integrity",
        "network": "none",
        "command": ["python", "/opt/platform/toolset_probe.py", "gdpval"]
      },
      "scoring": {
        "authority": "OpenAI GDPval rubrics and gold deliverables",
        "comparability": "proxy",
        "note": "Model rubric grading is a rough estimate; the standard remains pairwise human expert preference."
      },
      "env_allowlist": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY", "DEEPSEEK_API_KEY", "DEEPSEEK_BASE_URL"]
    },
