      "env_allowlist": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "DEEPSEEK_API_KEY", "DEEPSEEK_BASE_URL", "TOOLBENCH_KEY", "API_URL", "TRAJECT_TOOL_MODE"]
