# benchctl passes only allow-listed variable names into containers. Values stay
# in the caller's environment and are never written into run manifests.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
TOOLBENCH_KEY=
API_URL=
BENCHMARK_BUILD_PROXY=
BENCHMARK_PIP_INDEX_URL=
BENCHMARK_DOCKER_SOCKET_SOURCE=
# auto (default), inherit, direct, or a complete proxy URL. Rootless Docker setups
# with a daemon-injected proxy commonly need inherit.
BENCHMARK_RUN_PROXY=
BENCHMARK_RUN_NO_PROXY=
# Optional comma/space-separated hostname:ip pins passed to networked Docker containers.
BENCHMARK_DOCKER_ADD_HOSTS=
HARNESS_API_BASE=
HARNESS_API_KEY=
HARNESS_MODEL=
HARNESS_TEMPERATURE=0
HARNESS_API_TIMEOUT_S=180
HARNESS_API_RETRIES=3
# Optional and unset by default. HarnessEval never imposes a content cut.
HARNESS_MAX_OUTPUT_TOKENS=
HARNESS_REASONING_EFFORT=
